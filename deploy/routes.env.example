# SPDX-License-Identifier: Apache-2.0
#
# Routes of the waiting room, read by deploy/scripts/routes.sh.
# Copy to deploy/routes.env (git-ignored), or keep one file per target
# (e.g. deploy/test.env, deploy/prod.env) and pass it as second argument.
# Shell syntax: quote values that contain spaces or "*".

# Zone ID: dashboard -> your domain -> Overview, right column, under "API".
# Not the account ID that appears in the dashboard URL (dash.cloudflare.com/<account ID>/...).
ZONE_ID="0123456789abcdef0123456789abcdef"

# Hostnames served through the waiting room (proxied DNS records), space-separated.
HOSTS="shop.example.com"

# Paths routed to the Worker. Route syntax: "*" only at the end.
PROTECTED="/*"

# Paths that never reach the Worker: static assets, API/XHR, webhooks, payment callbacks.
# They become routes without a Worker, which win over the less specific "/*".
EXCLUDED="/static/* /media/* /api/* /webhooks/* /payment/callback/*"

# Worker name ("name" in wrangler/waitingroom.jsonc).
SCRIPT="waitingroom"

# Checked before `apply` creates anything.
PREFLIGHT_URL="https://waitingroom.<account-subdomain>.workers.dev/__wr/admin/v1/preflight"

# Secrets: export them in your shell rather than writing them here.
#   export CLOUDFLARE_API_TOKEN=...   Workers Routes > Edit on the zone (wrangler reads it too)
#   export WR_ADMIN_TOKEN=...    same value as the Worker secret
